{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/(?:config|database)(?:/|$)",
      "status": 404
    },
    {
      "src": "^/.*\\.(?:sql|md)$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
